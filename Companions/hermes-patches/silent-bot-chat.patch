+import unittest
+from unittest.mock import patch
+
+from agent.bot_chat_silence import MACHINE_TURN_ENV, bind_machine_turn, mark_silent_final
+
+
+class SilentPersistenceTests(unittest.TestCase):
+    def test_marker_preserves_raw_history_and_typed_resume_evidence(self):
+        from hermes_state import SessionDB
+        for text in ('[SILENT]', 'NO_REPLY', ' *NO_REPLY* '):
+            with self.subTest(text=text), tempfile.TemporaryDirectory() as temp:
+                agent = SimpleNamespace()
+                bind_machine_turn(agent, 'internal_notification', environ={})
+                row = dict(role='assistant', content=text, timestamp=100.0)
+                self.assertTrue(mark_silent_final(agent, row, text, successful=True))
+                with contextlib.closing(SessionDB(db_path=Path(temp)/'state.db')) as db:
+                    db.create_session('test', source='cli')
+                    db.replace_messages('test', [row])
+                    raw = db.get_messages('test')
+                    self.assertEqual(raw[-1]['content'], text)
+                    self.assertEqual(raw[-1]['display_kind'], 'hidden')
+                    from tui_gateway import server as srv
+                    resumed = srv._history_to_messages(raw)
+                    self.assertEqual(len(resumed), 1)
+                    self.assertEqual(resumed[0]['text'], text)
+                    self.assertEqual(resumed[0]['display_kind'], 'hidden')
+                    self.assertEqual(resumed[0]['display_metadata'],
+                                     {'control_marker': 'intentional_silence'})
+
+    def test_resume_preserves_quiet_turn_boundary_and_hides_other_scaffolding(self):
+        from copy import deepcopy
+        from tui_gateway import server as srv
+        history = [
+            dict(role='user', content='machine wake', display_kind='internal_notification',
+                 timestamp=100.0, _row_id=1),
+            dict(role='assistant', content='NO_REPLY', display_kind='hidden',
+                 display_metadata={'control_marker':'intentional_silence'}, timestamp=101.0, _row_id=2),
+            dict(role='user', content='NO_REPLY', timestamp=102.0, _row_id=3),
+            dict(role='assistant', content='NO_REPLY', timestamp=103.0, _row_id=4),
+            dict(role='assistant', content='hidden scaffold', display_kind='hidden'),
+            dict(role='assistant', content='hidden malformed', display_kind='hidden',
+                 display_metadata='intentional_silence'),
+            dict(role='user', content='hidden input', display_kind='hidden',
+                 display_metadata={'control_marker':'intentional_silence'}),
+        ]
+        original = deepcopy(history)
+        resumed = srv._history_to_messages(history)
+        self.assertEqual([row['row_id'] for row in resumed], [1,2,3,4])
+        self.assertEqual(resumed[0]['display_kind'], 'internal_notification')
+        self.assertEqual(resumed[1]['display_kind'], 'hidden')
+        self.assertEqual(resumed[1]['display_metadata']['control_marker'], 'intentional_silence')
+        self.assertEqual(resumed[1]['timestamp'], 101.0)
+        self.assertNotIn('display_kind', resumed[2])
+        self.assertNotIn('display_kind', resumed[3])
+        self.assertEqual(history, original)
+
+    def test_human_literal_failure_and_real_reply_are_preserved(self):
+        cases = [
+            (dict(role='user', content='[SILENT]'), '[SILENT]', True, True),
+            (dict(role='assistant', content='[SILENT]'), '[SILENT]', True, False),
+            (dict(role='assistant', content='[SILENT]'), '[SILENT]', False, True),
+            (dict(role='assistant', content='It says [SILENT].'), 'It says [SILENT].', True, True),
+            (dict(role='assistant', content='[SILENT]', tool_calls=[{'id':'a'}]), '[SILENT]', True, True),
+        ]
+        for row, response, successful, machine in cases:
+            with self.subTest(row=row, successful=successful, machine=machine):
+                original = dict(row)
+                self.assertFalse(mark_silent_final(SimpleNamespace(_machine_control_turn=machine), row,
+                                                   response, successful=successful))
+                self.assertEqual(row, original)
