# Copy this to ~/.config/hermes-push.env and fill it in. Everything below is a placeholder; real values never belong in git.
HERMES_PUSH_GATEWAY_URL=http://127.0.0.1:9119
HERMES_PUSH_GATEWAY_TOKEN=REPLACE_WITH_HERMES_DASHBOARD_SESSION_TOKEN
# HERMES_PUSH_GATEWAY_BEARER=            # use this in place of TOKEN when the gateway has its auth gate on
# HERMES_PUSH_CF_ACCESS_CLIENT_ID=       # needed only when the URL is behind Cloudflare Access
# HERMES_PUSH_CF_ACCESS_CLIENT_SECRET=
HERMES_PUSH_APNS_KEY_FILE=/home/you/.config/AuthKey_XXXXXXXXXX.p8
HERMES_PUSH_APNS_KEY_ID=XXXXXXXXXX
HERMES_PUSH_APNS_TEAM_ID=YYYYYYYYYY
# HERMES_PUSH_APNS_TOPIC=com.coreykozarski.nollie   # last resort only: every device file names its own bundle id
