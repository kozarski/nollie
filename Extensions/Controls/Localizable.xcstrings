    },
    "Ends every task, stops replies and pauses schedules." : {
      "comment" : "Safety: what the Stop control does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beendet jede Aufgabe, stoppt Antworten und pausiert Zeitpläne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termina todas las tareas, detiene las respuestas y pausa las programaciones."
