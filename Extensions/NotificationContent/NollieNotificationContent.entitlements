<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Reads the app's shared Keychain group, for the bot looks and relay key -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.coreykozarski.nollie.shared</string>
	</array>
</dict>
</plist>
