# The one Sparkle release the Direct Mac edition updates itself with (MIT, https://sparkle-project.org).
# This is the exact file Sparkle's own Swift package points at, with the checksum its Package.swift
# carries. Change these with the entry in Tools/pins.json and NOLLIE_SPARKLE_VERSION in the project, then
# run: python3 Tools/dev/check-latest.py --local
SPARKLE_VERSION=2.10.1
SPARKLE_URL=https://github.com/sparkle-project/Sparkle/releases/download/2.10.1/Sparkle-for-Swift-Package-Manager.zip
SPARKLE_BYTES=10197413
SPARKLE_SHA256=4c2e48a3e50ebcc2c88a58a4c7264a1a99c3c31857ce754357afb9cdb323022a
