# The one Cua Driver release Nollie Computer is built from (MIT, https://github.com/trycua/cua).
# Change these together, then rebuild and re-test (Docs/nollie-computer.md).
DRIVER_VERSION=0.46.1
DRIVER_TAG=cua-driver-rs-v0.46.1
DRIVER_REPO=https://github.com/trycua/cua.git
# Git object ids are SHA-1 checksums of the exact source: the tag's commit, the driver workspace
# and the one crate it links from outside that workspace. The commit id covers every other file
# the build reads (that crate's workspace manifest and two JSON files it includes).
DRIVER_COMMIT=93c9b500a0d4f9daa56063d3d3e3fb3c9e6070ee
DRIVER_TREE=546baafec8f7221c83f12fdcd604d172419b5e55
TELEMETRY_TREE=b4f052b58ad45e8f98010c61b76ea1c9832134e8
DRIVER_LOCK_SHA256=ec1fbefd2c095b178375f598b455972ce2a6a1b072d2deeab6f3552263d4e5b0
# The helper this source builds (Apple silicon, source paths remapped so any build folder gives it).
DRIVER_BINARY_SHA256=94a8c1728d4f72f0e3a8b409fb56b2f6066804cc578e6bbd10ba10a882065db4

# The Rust release the driver pins (its rust-toolchain.toml), from static.rust-lang.org.
RUST_VERSION=1.97.1
RUST_ARCHIVE=rust-1.97.1-aarch64-apple-darwin.tar.xz
RUST_URL=https://static.rust-lang.org/dist/2026-07-16/rust-1.97.1-aarch64-apple-darwin.tar.xz
RUST_SHA256=c9748cc86107734a2a024069908a895de7caa2d37062fb641eef9f756938ace2
