<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>teamID</key>
	<string>5985LRZFZS</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- We stamp the build number in testflight.sh, so Xcode must not rewrite it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<!-- Manual signing, as on iOS: an App Manager API key may not create cloud-managed
	     certificates. The app and its three extensions each need a Mac App Store profile with
	     these names, and the keychain needs the Mac installer certificate for the .pkg. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>installerSigningCertificate</key>
	<string>3rd Party Mac Developer Installer</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.coreykozarski.nollie</key>
		<string>Nollie Mac App Store</string>
		<key>com.coreykozarski.nollie.notifications</key>
		<string>Nollie Mac Notification Service App Store</string>
		<key>com.coreykozarski.nollie.controls</key>
		<string>Nollie Mac Controls App Store</string>
	</dict>
</dict>
</plist>
