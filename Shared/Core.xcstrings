    "This gateway has no auth gate and wants the dashboard session token (HERMES_DASHBOARD_SESSION_TOKEN). Change the auth mode to “Session token”." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Gateway hat keine Auth-Sperre und will das Dashboard-Sitzungstoken (HERMES_DASHBOARD_SESSION_TOKEN). Stell den Auth-Modus auf „Sitzungstoken“ um."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette passerelle n'a pas de barrière d'authentification et demande le jeton de session du tableau de bord (HERMES_DASHBOARD_SESSION_TOKEN). Passez le mode d'authentification à « Jeton de session »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta pasarela no tiene barrera de autenticación y pide el token de sesión del panel (HERMES_DASHBOARD_SESSION_TOKEN). Cambia el modo de autenticación a «Token de sesión»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このゲートウェイには認証ゲートがなく、ダッシュボードのセッショントークン（HERMES_DASHBOARD_SESSION_TOKEN）を必要としています。認証モードを「セッショントークン」に変更してください。"
          }
        }
      }
    },
    "This gateway is closed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
