{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Info.plist NSCalendarsFullAccessUsageDescription: shown by the system when it asks for this permission",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nollie lets the helpers you choose see your calendar. Nothing changes without your yes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nollie lässt die Helfer, die du auswählst, deinen Kalender sehen. Ohne dein Ja ändert sich nichts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nollie permet aux assistants que vous choisissez de voir votre calendrier. Rien ne change sans votre accord."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nollie permite a los ayudantes que elijas ver tu calendario. Nada cambia sin tu sí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nollieは、あなたが選んだヘルパーにカレンダーを見せます。あなたの許可なしに変更されることはありません。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Info.plist NSCameraUsageDescription: shown by the system when it asks for this permission",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Take a photo to attach to a chat with your Hermes agent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nimm ein Foto auf, um es an einen Chat mit deinem Hermes-Agenten anzuhängen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prenez une photo à joindre à une discussion avec votre agent Hermes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haz una foto para adjuntarla a un chat con tu agente de Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hermesエージェントとのチャットに添付する写真を撮ります。"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Info.plist NSContactsUsageDescription: shown by the system when it asks for this permission",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nollie lets the helpers you choose find people in your contacts. Nothing changes without your yes."
