        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nollie permite a los ayudantes que elijas buscar personas en tus contactos. Nada cambia sin tu sí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nollieは、あなたが選んだヘルパーが連絡先から人を探せるようにします。あなたの許可なしに変更されることはありません。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Info.plist NSLocalNetworkUsageDescription: shown by the system when it asks for this permission",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Let your iPhone find this Mac on your Wi-Fi, and connect to a Hermes dashboard on your local network."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit dein iPhone diesen Mac in deinem WLAN findet und eine Verbindung zu einem Hermes-Dashboard in deinem lokalen Netzwerk herstellt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à votre iPhone de trouver ce Mac sur votre Wi-Fi et de se connecter à un tableau de bord Hermes sur votre réseau local."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que tu iPhone encuentre este Mac en tu red Wi-Fi y que se conecte a un panel de Hermes en tu red local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhoneがWi-Fi上でこのMacを見つけたり、ローカルネットワーク上のHermesダッシュボードに接続したりできるようにします。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
