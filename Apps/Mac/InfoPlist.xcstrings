        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nollie lässt die Helfer, die du auswählst, Personen in deinen Kontakten finden. Ohne dein Ja ändert sich nichts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nollie permet aux assistants que vous choisissez de trouver des personnes dans vos contacts. Rien ne change sans votre accord."
