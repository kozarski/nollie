          "stringUnit" : {
            "state" : "needs_review",
            "value" : "チャットとその記録はゲートウェイから削除されます。"
          }
        }
      }
    },
    "The chat is intact either way. Send a message such as “continue” and the bot carries on from what it had done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
