        }
      }
    },
    "Only on %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ behält sie für sich"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo en %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uniquement sur %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@のみ"
          }
        }
      }
    },
    "Only root instructions and an inactive configuration backup are copied. Configuration may include sensitive settings. Profiles, separate credential files, chats, schedules, Board and computer permissions stay in the original setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur die Anweisungen aus dem obersten Ordner und ein inaktives Konfigurations-Backup werden kopiert. Die Konfiguration kann vertrauliche Einstellungen enthalten. Profile, separate Zugangsdaten-Dateien, Chats, Zeitpläne, das Board und Computer-Berechtigungen bleiben in der ursprünglichen Einrichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo se copian las instrucciones de la raíz y una copia de seguridad inactiva de la configuración. La configuración puede incluir ajustes sensibles. Los perfiles, archivos de credenciales aparte, chats, programaciones, Tablero y permisos del ordenador se quedan en la configuración original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seules les instructions à la racine et une sauvegarde inactive de la configuration sont copiées. La configuration peut contenir des réglages sensibles. Les profils, les fichiers d'identifiants séparés, les discussions, les planifications, le Tableau et les autorisations de l'ordinateur restent dans la configuration d'origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "コピーされるのはルートの指示と、無効化された設定のバックアップのみです。設定には機密性の高い設定が含まれている場合があります。プロファイル、別の認証情報ファイル、チャット、スケジュール、ボード、コンピュータのアクセス許可は元の設定に残ります。"
          }
        }
      }
    },
    "Only scan a code from your own Mac. The code works once and expires after two minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scanne nur einen Code von deinem eigenen Mac. Der Code funktioniert einmal und läuft nach zwei Minuten ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escanea solo un código de tu propio Mac. El código funciona una vez y caduca a los dos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne scannez qu'un code de votre propre Mac. Le code fonctionne une fois et expire au bout de deux minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自分のMacのコードだけをスキャンしてください。コードは1回だけ使え、2分後に期限切れになります。"
          }
        }
      }
    },
    "Only the apps you approve, one task at a time." : {
