          }
        }
      }
    },
    "The files are on the gateway, but the new companion did not report in within two minutes. %@ Restart the gateway once more (Settings, Gateway), then check again here. If it still does not report, open the Companion page and run the test." : {
      "comment" : "%@ is a sentence about the last heartbeat",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Dateien sind auf dem Gateway, aber der neue Companion hat sich nicht innerhalb von zwei Minuten gemeldet. %@ Starte das Gateway noch einmal neu („Einstellungen“, „Gateway“) und prüfe dann hier erneut. Meldet er sich immer noch nicht, öffne die Seite „Companion“ und starte den Test."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los archivos están en la pasarela, pero el nuevo Companion no dio señales en dos minutos. %@ Reinicia la pasarela una vez más (Ajustes, Pasarela) y vuelve a comprobarlo aquí. Si sigue sin dar señales, abre la página de Companion y haz la prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fichiers sont sur la passerelle, mais le nouveau Companion ne s'est pas manifesté en deux minutes. %@ Redémarrez à nouveau la passerelle (Réglages, Passerelle), puis revérifiez ici. S'il ne se manifeste toujours pas, ouvrez la page Companion et lancez le test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ファイルはゲートウェイにありますが、新しいコンパニオンから2分以内に連絡がありませんでした。%@ ゲートウェイをもう一度再起動してから（「設定」›「ゲートウェイ」）、ここでもう一度確認してください。それでも連絡がない場合は、「コンパニオン」ページを開いてテストを実行してください。"
          }
        }
      }
    },
    "The gateway could not send this file: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Gateway konnte diese Datei nicht senden: %@"
