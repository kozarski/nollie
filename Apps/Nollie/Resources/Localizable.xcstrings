    "Online models may cost money. Checking which model runs uses no online account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Online-Modelle können Geld kosten. Die Prüfung, welches Modell läuft, verwendet keinen Online-Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los modelos en línea pueden costar dinero. Comprobar qué modelo se ejecuta no usa ninguna cuenta en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les modèles en ligne peuvent être payants. Vérifier quel modèle fonctionne n'utilise aucun compte en ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オンラインのモデルは料金がかかる場合があります。どのモデルが動いているかの確認には、オンラインのアカウントは使いません。"
          }
        }
      }
    },
    "Only actions the gateway's approval mode holds for a person reach %@. In a mode that approves low-risk commands on its own, most turns never ask." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur Aktionen, die der Freigabemodus des Gateways für einen Menschen zurückhält, bekommt %@. In einem Modus, der risikoarme Befehle selbst freigibt, fragen die meisten Durchgänge nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo las acciones que el modo de aprobación de la pasarela retiene para una persona llegan a %@. En un modo que aprueba por sí solo los comandos de bajo riesgo, la mayoría de los turnos nunca preguntan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seules les actions que le mode d'autorisation de la passerelle retient pour une personne arrivent sur %@. Dans un mode qui approuve seul les commandes à faible risque, la plupart des tours ne demandent jamais rien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ゲートウェイの承認モードが人の判断のために保留した操作だけが%@に届きます。リスクの低いコマンドを自動で承認するモードでは、ほとんどのターンで確認されません。"
          }
        }
      }
    },
    "Only connect a Mac you own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbinde nur einen Mac, der dir gehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conecta solo un Mac que sea tuyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne connectez qu'un Mac qui vous appartient."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自分のMacにだけ接続してください。"
          }
        }
      }
    },
    "Only link a Mac you own." : {
      "localizations" : {
