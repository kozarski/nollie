    },
    "The gateway is on an older companion. Restart it to load v%@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Gateway nutzt einen älteren Companion. Starte es neu, um v%@ zu laden."
