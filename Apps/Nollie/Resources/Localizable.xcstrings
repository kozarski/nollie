      }
    },
    "Pairing needs an existing secure address with sign-in. You can still connect manually on your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Kopplung braucht eine vorhandene sichere Adresse mit Anmeldung. Du kannst dich auf deinem iPhone trotzdem manuell verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
