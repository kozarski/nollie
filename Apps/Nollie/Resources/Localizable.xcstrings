          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El chat y sus mensajes se eliminan de la pasarela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La discussion et ses messages sont supprimés de la passerelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "チャットとそのメッセージはゲートウェイから削除されます。"
          }
        }
