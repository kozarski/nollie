    "Stops the service and removes the plugin and its files from the gateway, and %@ forgets the setup. Installing again starts fresh." : {
      "comment" : "%@ is this iPhone, this iPad or this Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stoppt den Dienst, entfernt das Plug-in und seine Dateien vom Gateway, und %@ vergisst die Einrichtung. Eine neue Installation beginnt von vorn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
