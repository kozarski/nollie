    "Ends every task, stops replies and pauses schedules." : {
      "comment" : "Safety: what the Stop control does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beendet jede Aufgabe, stoppt Antworten und pausiert Zeitpläne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termina todas las tareas, detiene las respuestas y pausa las programaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Met fin à chaque tâche, arrête les réponses et suspend les planifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すべてのタスクを終了し、返信を止め、スケジュールを一時停止します。"
          }
        }
      }
    },
    "Ends the helper's task on your Mac, stops replies and pauses schedules." : {
      "comment" : "Safety: what Stop does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beendet die Aufgabe des Helfers auf deinem Mac, stoppt Antworten und pausiert Zeitpläne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termina la tarea del ayudante en tu Mac, detiene las respuestas y pausa las programaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Met fin à la tâche de l'assistant sur votre Mac, arrête les réponses et suspend les planifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac上のヘルパーのタスクを終了し、返信を止め、スケジュールを一時停止します。"
          }
        }
      }
    },
    "Ends the helper's task, stops replies and pauses schedules." : {
