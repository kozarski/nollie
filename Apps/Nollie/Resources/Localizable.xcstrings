    },
    "Signs up with the push relay and puts %@'s device file on the gateway. Content is encrypted with a key only %@ holds." : {
      "comment" : "%@ is this iPhone, this iPad or this Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registriert sich beim Push-Relay und legt eine Gerätedatei auf das Gateway, damit %1$@ dort bekannt ist. Inhalte werden mit einem Schlüssel verschlüsselt, den nur %2$@ hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Signs up with the push relay and puts %1$@'s device file on the gateway. Content is encrypted with a key only %2$@ holds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se registra en el relé de push y pone el archivo del dispositivo de %1$@ en la pasarela. El contenido se cifra con una clave que solo tiene %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S'inscrit auprès du relais push et place le fichier d'appareil de %1$@ sur la passerelle. Le contenu est chiffré avec une clé que seul %2$@ détient."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "プッシュリレーに登録し、%1$@のデバイスファイルをゲートウェイに配置します。内容は%2$@だけが持つキーで暗号化されます。"
          }
        }
      }
    },
