          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El chat queda intacto en ambos casos. Envía un mensaje como «continúa» y el bot sigue desde lo que había hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
