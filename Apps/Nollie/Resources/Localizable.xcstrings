    },
    "The companion is up but cannot reach the gateway: %@. Go back, fix the address or sign-in, and install again. It switches within ten seconds, no restart needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Companion läuft, erreicht das Gateway aber nicht: %@. Geh zurück, korrigiere Adresse oder Anmeldung und installiere erneut. Er wechselt innerhalb von zehn Sekunden, ohne Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Companion está en marcha pero no llega a la pasarela: %@. Vuelve atrás, corrige la dirección o el inicio de sesión e instala de nuevo. Cambia en diez segundos, sin reiniciar."
          }
