    "Buying always waits for your yes, and nobody could answer then, so it wasn't done." : {
      "comment" : "Safety: Ask first held a payment; keep exact meaning",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaufen wartet immer auf dein Ja. Da niemand antworten konnte, wurde es nicht getan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comprar siempre espera tu sí, y en ese momento nadie podía responder, así que no se hizo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acheter attend toujours votre accord, et personne ne pouvait répondre à ce moment-là, donc ce n'a pas été fait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "購入は必ずあなたの許可を待ちます。そのとき答えられる人がいなかったため、実行されませんでした。"
          }
        }
      }
    },
