          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrête le service, supprime le plugin et ses fichiers de la passerelle, et %@ oublie la configuration. Une nouvelle installation repart de zéro."
