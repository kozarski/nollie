          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con Confirmar desde la pantalla bloqueada activado, un «Aprobar» desde una notificación abre el chat y vuelve a preguntar en las acciones arriesgadas. Puedes cambiarlo en Ajustes › Privacidad."
          }
