    "A small plugin on your gateway. It sends replies as notifications and brings approval cards to %@ as soon as a bot needs a yes." : {
      "comment" : "%@ is your iPhone, your iPad or your Mac",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein kleines Plug-in auf deinem Gateway. Es sendet Antworten als Mitteilungen, und %@ bekommt Freigabekarten, sobald ein Bot ein Ja braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un pequeño plugin en tu pasarela. Envía las respuestas como notificaciones y lleva las tarjetas de aprobación a %@ en cuanto un bot necesita un sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un petit plugin sur votre passerelle. Il envoie les réponses sous forme de notifications et apporte les cartes d'autorisation sur %@ dès qu'un bot a besoin de votre accord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ゲートウェイ上の小さなプラグインです。返信を通知として送り、ボットにあなたの許可が必要になるとすぐに%@に承認カードを届けます。"
          }
        }
      }
    },
    "A spoken conversation. Replies are read aloud." : {
      "localizations" : {
