    },
    "Settings › Advanced › Companion › This device must show the relay registered and the device file published. Register again if either is missing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unter „Einstellungen“ › „Erweitert“ › „Companion“ › „Dieses Gerät“ muss das Relay als registriert und die Gerätedatei als veröffentlicht stehen. Registriere dich erneut, wenn eines fehlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajustes › Avanzado › Companion › Este dispositivo debe mostrar el relé registrado y el archivo del dispositivo publicado. Vuelve a registrarlo si falta alguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Réglages › Avancé › Companion › Cet appareil doit indiquer le relais enregistré et le fichier d'appareil publié. Réenregistrez si l'un des deux manque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「設定」›「詳細」›「コンパニオン」›「このデバイス」で、リレーが登録済み、デバイスファイルが公開済みと表示される必要があります。どちらかがない場合は、もう一度登録してください。"
          }
        }
      }
    },
    "Settings › Advanced › Companion › This device › Approval requests says whether the gateway agreed to send them and how many arrived. \"Not acknowledged\" means an older Hermes: update it on the gateway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Einstellungen“ › „Erweitert“ › „Companion“ › „Dieses Gerät“ › „Freigabeanfragen“ zeigt, ob das Gateway zugestimmt hat, sie zu senden, und wie viele angekommen sind. „Not acknowledged“ heißt: ein älteres Hermes. Aktualisiere es auf dem Gateway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajustes › Avanzado › Companion › Este dispositivo › Solicitudes de aprobación indica si la pasarela aceptó enviarlas y cuántas llegaron. «Sin confirmar» significa un Hermes más antiguo: actualízalo en la pasarela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Réglages › Avancé › Companion › Cet appareil › Demandes d'autorisation indique si la passerelle a accepté de les envoyer et combien sont arrivées. « Not acknowledged » signifie un Hermes plus ancien : mettez-le à jour sur la passerelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「設定」›「詳細」›「コンパニオン」›「このデバイス」›「承認リクエスト」に、ゲートウェイが送信に同意したかと、何件届いたかが表示されます。「Not acknowledged」は古いHermesという意味です：ゲートウェイでアップデートしてください。"
          }
        }
      }
    },
    "Settings › Notifications can turn it on later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unter Einstellungen › Mitteilungen kannst du es später einschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes activarlas más tarde en Ajustes › Notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Réglages › Notifications permet de l'activer plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "後から「設定」›「通知」でオンにできます。"
          }
        }
      }
    },
