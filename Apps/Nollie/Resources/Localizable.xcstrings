            "value" : "ゲートウェイは古いコンパニオンで動いています。再起動してv%@を読み込んでください。"
          }
        }
      }
    },
    "The gateway is saved, but %@ could not keep your sign-in (%@). Save again to continue without it." : {
      "comment" : "The first %@ is this Mac, this iPhone or this iPad; the second is the reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Gateway ist gesichert, aber %1$@ konnte deine Anmeldung nicht behalten (%2$@). Sichere erneut, um ohne sie fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The gateway is saved, but %1$@ could not keep your sign-in (%2$@). Save again to continue without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La pasarela se ha guardado, pero %1$@ no ha podido guardar tu inicio de sesión (%2$@). Vuelve a guardar para continuar sin él."
          }
        },
        "fr" : {
          "stringUnit" : {
