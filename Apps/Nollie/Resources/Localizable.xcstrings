    "No scheme given, so we use https. Type http:// for a plain connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kein Schema angegeben, daher verwenden wir https. Gib http:// für eine unverschlüsselte Verbindung ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se ha indicado esquema, así que usamos https. Escribe http:// para una conexión sin cifrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun schéma indiqué, nous utilisons donc https. Tapez http:// pour une connexion simple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スキームが指定されていないため、httpsを使います。暗号化なしで接続するにはhttp://と入力してください。"
          }
        }
      }
    },
    "No scheme given, so we use plain http. Type https:// if your gateway has a certificate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kein Schema angegeben, daher verwenden wir einfaches http. Gib https:// ein, wenn dein Gateway ein Zertifikat hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se ha indicado esquema, así que usamos http sin cifrar. Escribe https:// si tu pasarela tiene un certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun schéma indiqué, nous utilisons donc http simple. Tapez https:// si votre passerelle a un certificat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スキームが指定されていないため、暗号化なしのhttpを使います。ゲートウェイに証明書がある場合はhttps://と入力してください。"
          }
        }
