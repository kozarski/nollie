    "Setup checks that no tasks are running. It won't restart Hermes. The backup contains companion files, not your chats or credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Einrichtung prüft, dass keine Aufgaben laufen. Hermes wird nicht neu gestartet. Das Backup enthält Companion-Dateien, nicht deine Chats oder Zugangsdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuración comprueba que no haya tareas en marcha. No reiniciará Hermes. La copia de seguridad contiene archivos del Companion, no tus chats ni tus credenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuration vérifie qu'aucune tâche n'est en cours. Elle ne redémarre pas Hermes. La sauvegarde contient les fichiers du Companion, pas vos discussions ni vos identifiants."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "設定時に、実行中のタスクがないことを確認します。Hermesは再起動しません。バックアップにはコンパニオンのファイルが含まれ、チャットや認証情報は含まれません。"
          }
        }
      }
    },
    "Setup continues in the background. Check the connection when you're ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Einrichtung läuft im Hintergrund weiter. Prüfe die Verbindung, wenn du so weit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuración continúa en segundo plano. Comprueba la conexión cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuration continue en arrière-plan. Vérifiez la connexion quand vous serez prêt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "設定はバックグラウンドで続きます。準備ができたら接続を確認してください。"
          }
        }
      }
    },
    "Setup couldn't finish. Downloaded files are kept. Check your connection and available disk space before trying again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Einrichtung konnte nicht abgeschlossen werden. Geladene Dateien bleiben erhalten. Prüfe deine Verbindung und den freien Speicherplatz, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuración no ha podido terminar. Los archivos descargados se conservan. Comprueba la conexión y el espacio libre en disco antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuration n'a pas pu se terminer. Les fichiers téléchargés sont conservés. Vérifiez votre connexion et l'espace disque disponible avant de réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "設定を完了できませんでした。ダウンロード済みのファイルは保持されます。もう一度試す前に、接続とディスクの空き容量を確認してください。"
          }
        }
      }
    },
