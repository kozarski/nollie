            "value" : "Save a picture from a chat to your Photos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Bild aus einem Chat in deinen Fotos sichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enregistrer une image d'une discussion dans vos Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guarda una imagen de un chat en tus Fotos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "チャットの画像を写真に保存します。"
          }
